meta {
  name: Create upload
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/datasets/uploads/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "module": "pollinators",
    "name": "Camera A test"
  }
}

script:post-response {
  if ((res.status === 200 || res.status === 201) && res.body && res.body.id) {
    bru.setEnvVar("uploadId", String(res.body.id));
  }
}

tests {
  test("status is 201", function() {
    expect(res.status).to.equal(201);
  });
  test("returns an id", function() {
    expect(res.body.id).to.be.a("number");
  });
  test("image_count starts at 0", function() {
    expect(res.body.image_count).to.equal(0);
  });
}
