meta {
  name: Create upload (missing module)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/datasets/uploads/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Missing module"
  }
}

tests {
  test("status is 400", function() {
    expect(res.status).to.equal(400);
  });
  test("error mentions module field", function() {
    expect(JSON.stringify(res.body)).to.contain("module");
  });
}
