meta {
  name: Create training
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/api/pollinator/training/
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "Bruno test training",
    "config": {
      "track": "detector",
      "from_model_version_id": {{yoloModelId}},
      "epochs": 5,
      "train_split": 70,
      "val_split": 15,
      "test_split": 15,
      "stratified": true
    }
  }
}

script:post-response {
  if ((res.status === 200 || res.status === 201) && res.body && res.body.id) {
    bru.setEnvVar("trainingJobId", String(res.body.id));
  }
}

tests {
  test("status is 201 (created) or 409 (already busy)", function() {
    expect([201, 409]).to.include(res.status);
  });
  test("on 201, returns a training job id", function() {
    if (res.status === 201) {
      expect(res.body.id).to.be.a("number");
      expect(["pending", "running"]).to.include(res.body.status);
    }
  });
}
