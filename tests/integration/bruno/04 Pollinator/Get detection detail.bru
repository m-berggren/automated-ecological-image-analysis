meta {
  name: Get detection detail
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/pollinator/detections/{{detectionId}}/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("returns pollinator-shaped detection", function() {
    expect(res.body.id).to.be.a("number");
    expect(res.body).to.have.property("yolo_class");
    expect(res.body).to.have.property("source");
  });
}
