meta {
  name: List detections
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/analysis/runs/{{runId}}/detections/
  body: none
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("body is an array", function() {
    expect(res.body).to.be.an("array");
  });
}
