meta {
  name: Login bad credentials
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/auth/login/
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "definitely-not-the-password"
  }
}

tests {
  test("status is 401", function() {
    expect(res.status).to.equal(401);
  });
}
