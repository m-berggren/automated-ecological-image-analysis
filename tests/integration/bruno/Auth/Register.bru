meta {
  name: Register
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/auth/register/
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}",
    "email": "{{email}}"
  }
}

tests {
  test("status is 200 or 201", function() {
    expect([200, 201]).to.include(res.status);
  });
}
