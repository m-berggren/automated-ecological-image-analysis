# Copy to .env and fill in real values before `docker compose up`.

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1
# Public origin(s) the admin/browsable API are reached on (scheme + host + port).
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Same-origin via nginx, so CORS is off. Set true only for a split-origin setup.
CORS_ALLOW_ALL=false

# ── Database (consumed by both Django and the postgres container) ────────────
SQL_ENGINE=django.db.backends.postgresql
SQL_DATABASE=ecosia
SQL_USER=ecosia
SQL_PASSWORD=change-me
SQL_HOST=db
SQL_PORT=5432

# ── Gunicorn ─────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120

# ── Web ──────────────────────────────────────────────────────────────────────
# Host port nginx is published on; open http://localhost:${WEB_PORT}.
WEB_PORT=8080
# Leave empty for same-origin (nginx proxy). Set to a full URL for split-origin.
VITE_API_BASE_URL=
